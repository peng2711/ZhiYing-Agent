# EchoMind 环境变量示例（复制为 .env 后填写真实值）
ANTHROPIC_API_KEY=your_api_key
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
ANTHROPIC_BASE_URL=

APP_ENV=development
ECHOMIND_API_KEY=replace-with-a-long-random-key
LOG_LEVEL=INFO
ECHOMIND_LLM_TIMEOUT_S=45
ECHOMIND_MAX_TOOL_ROUNDS=3
ECHOMIND_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

REDIS_PASSWORD=replace-with-a-long-random-redis-password
REDIS_URL=redis://:${REDIS_PASSWORD}@localhost:6379/0
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_PERSIST_DIRECTORY=./data/chroma

PROMETHEUS_PORT=0
MONITOR_INTERVAL=10
ALERT_WEBHOOK_URL=
EVAL_AUTO_PROMOTE_BASELINE=false
