# ZhiYing Agent 环境变量示例（复制为 .env 后填写真实值）
LLM_API_KEY=your_dashscope_api_key
LLM_MODEL=qwen3.7-plus
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_PROVIDER=qwen_openai
QWEN_THINKING=disabled

# 按环节指定模型（可选，留空则使用 LLM_MODEL）。意图识别、改写、重排、记忆压缩是轻任务，可换更便宜的模型；
# Judge 应固定为与被测模型不同系列的模型，避免自我偏好，并保证多次评测分数可比。
# Agent 另有 ZHIYING_GENERAL_MODEL / ZHIYING_TECHNICAL_MODEL / ZHIYING_BILLING_MODEL / ZHIYING_ESCALATION_MODEL。
ZHIYING_INTENT_MODEL=
ZHIYING_REWRITE_MODEL=
ZHIYING_RERANK_MODEL=
ZHIYING_COMPOSER_MODEL=
ZHIYING_MEMORY_MODEL=
ZHIYING_JUDGE_MODEL=

APP_ENV=development
ZHIYING_API_KEY=replace-with-a-long-random-key
ZHIYING_USER_ID_SECRET=replace-with-a-random-secret
LOG_LEVEL=INFO
ZHIYING_LLM_TIMEOUT_S=45
ZHIYING_MAX_TOOL_ROUNDS=3
# 单个 Agent 执行的总时间预算（秒），每轮 LLM 超时取它和 ZHIYING_LLM_TIMEOUT_S 中较小者
ZHIYING_AGENT_DEADLINE_S=90
# 单次请求的 token 上限（输入+输出），0 表示不限制
ZHIYING_REQUEST_TOKEN_BUDGET=0
ZHIYING_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
ZHIYING_ALLOW_CLIENT_USER_ID=false

REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_PERSIST_DIRECTORY=./data/chroma
BUSINESS_DB_PATH=./data/business/business.db

PROMETHEUS_PORT=0
MONITOR_INTERVAL=10
ALERT_WEBHOOK_URL=
EVAL_AUTO_PROMOTE_BASELINE=false

# 外部 MCP Server（JSON 数组，留空表示不启用）。只挂载 tools 里显式列出且声明为只读的工具。
# 示例：把本项目的知识库 MCP Server 以 stdio 方式挂给通用 Agent
# ZHIYING_MCP_SERVERS=[{"name":"kb","transport":"stdio","command":"python","args":["-m","tooling.mcp_server"],"agents":["general"],"tools":["list_knowledge_versions"]}]
ZHIYING_MCP_SERVERS=

# LLM 单价（可选，每百万 token 的价格，币种自定）。配置后 /chat 的 token_usage 和 Trace 会给出估算费用。
# ZHIYING_LLM_PRICING={"qwen3.7-plus":{"input":0.8,"cached_input":0.16,"output":2.0}}
ZHIYING_LLM_PRICING=

# 知识库和记忆的 embedding 模型：bge-small-zh（默认，中文）或 default（ChromaDB 内置 all-MiniLM-L6-v2，以英文为主）。
# 每个模型使用独立 collection；启动时若新 collection 为空，会自动从旧 collection 迁移（旧数据保留，改回即可回滚）。
# 也可提前手动迁移：python -m tooling.migrate_embeddings --from default --to bge-small-zh
ZHIYING_EMBEDDING_MODEL=bge-small-zh
# 模型缓存目录，默认 ~/.cache/fastembed（Docker 镜像已预置模型）
ZHIYING_EMBEDDING_CACHE_DIR=

# Agent 检索链路（默认值来自检索评测，见 README）
# 查询改写：换成中文 embedding 后几乎不提升召回，每次检索多约 1.6 秒，默认关闭
ZHIYING_RAG_QUERY_REWRITE=false
# LLM 重排：always / auto / never；auto 只在前两个文档分数差小于阈值时触发
ZHIYING_RAG_RERANK=auto
ZHIYING_RAG_RERANK_MARGIN=0.03
