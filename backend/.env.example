# ZhiYing Agent 环境变量示例（复制为 .env 后填写真实值）
LLM_API_KEY=your_deepseek_api_key
LLM_MODEL=deepseek-v4-pro
LLM_BASE_URL=https://api.deepseek.com
LLM_PROVIDER=deepseek_openai
DEEPSEEK_THINKING=disabled

APP_ENV=development
ZHIYING_API_KEY=replace-with-a-long-random-key
ZHIYING_USER_ID_SECRET=replace-with-a-random-secret
LOG_LEVEL=INFO
ZHIYING_LLM_TIMEOUT_S=45
ZHIYING_MAX_TOOL_ROUNDS=3
ZHIYING_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
ZHIYING_ALLOW_CLIENT_USER_ID=false

REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_PERSIST_DIRECTORY=./data/chroma

PROMETHEUS_PORT=0
MONITOR_INTERVAL=10
ALERT_WEBHOOK_URL=
EVAL_AUTO_PROMOTE_BASELINE=false
